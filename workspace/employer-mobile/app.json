{
  "expo": {
    "name": "JobOn",
    "slug": "jobon-employer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jobonemployer",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jobon.employer",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "JobOn needs your photos so you can upload your shop licence and photos.",
        "NSCameraUsageDescription": "JobOn uses the camera so you can photograph your shop licence."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.jobon.employer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CALL_PHONE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "./plugins/withTileUserAgent",
        {
          "userAgent": "JobOn-Employer/1.0 (+https://jobon.in; hello@jobon.in)"
        }
      ],
      "expo-location",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JobOn needs your photos so you can upload your shop licence and photos.",
          "cameraPermission": "JobOn uses the camera so you can photograph your shop licence."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "office.v1"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://jobon.api.mindsyncos.com/api"
    }
  }
}
