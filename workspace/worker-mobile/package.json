{
  "name": "worker-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.20.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start --dev-client --port 8081",
    "android": "expo run:android --port 8081",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client --port 8081",
    "dev:local": "EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api expo start --dev-client --port 8081 --clear",
    "dev:apk": "cd android && ./gradlew app:assembleDebug -x lint -x test -PreactNativeArchitectures=arm64-v8a,armeabi-v7a,x86_64 && echo 'Debug app: android/app/build/outputs/apk/debug/app-debug.apk'",
    "apk": "cd android && ./gradlew app:assembleRelease -x lint -x test -PreactNativeArchitectures=arm64-v8a,armeabi-v7a,x86,x86_64",
    "apk:fast": "cd android && ./gradlew app:assembleRelease -x lint -x test -PreactNativeArchitectures=arm64-v8a"
  },
  "private": true
}
